*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local secrets and environment configuration
.env
.env.*
!.env.example
!.env.sample

# Local databases and runtime uploads
*.db
*.sqlite
*.sqlite3
uploads/*
!uploads/.gitkeep

# Logs, temporary files, and generated runtime data
*.log
*.tmp
*.temp
*.bak
*.swp
.DS_Store
Thumbs.db

# IDE and editor settings
.vscode/
.idea/
*.sublime-workspace

# Node/build artifacts (if frontend tooling is added)
node_modules/
dist/
build/
coverage/
